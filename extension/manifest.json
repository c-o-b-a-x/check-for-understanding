{
  "manifest_version": 3,
  "name": "Site to Quiz JSON",
  "version": "1.0.0",
  "description": "Read the current page and generate quiz JSON for Check for Understanding using a user-provided Gemini API key.",
  "permissions": ["activeTab", "storage", "tabs"],
  "host_permissions": [
    "<all_urls>",
    "https://generativelanguage.googleapis.com/*"
  ],
  "action": {
    "default_title": "Site to Quiz JSON",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
